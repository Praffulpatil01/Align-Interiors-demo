# Align Interiors — Environment Variables Template
# Copy this file to .env for local testing with netlify dev, or configure in Netlify Dashboard:
# Site Settings > Build & deploy > Environment > Environment variables

# 1. Email Service Provider API Key (Resend recommended: https://resend.com)
RESEND_API_KEY="re_1234567890abcdef"

# 2. Studio Notification Recipient Email (Owner / Lead Designer Inbox)
NOTIFICATION_EMAIL="info@aligninteriors.in"

# 3. Verified Sender Address (must be a verified domain on Resend/SendGrid)
SENDER_EMAIL="enquiries@aligninteriors.in"
